# ===== .env.example — ENV ที่โค้ดอ่านจริง (ตรงกับ REPO-MAP.md §5) =====
# คัดลอกเป็น .env.local แล้วกรอกค่า · ห้าม commit ไฟล์ที่มีค่าจริง (.gitignore: .env*)

# ===== หลัก (จำเป็นต่อการรันขั้นต่ำ) =====
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
GEMINI_API_KEY=

# ===== ความจำลูกค้า (Neon Postgres) =====
DATABASE_URL=

# ===== คลังความรู้ BotLibrary (Google Sheets API · batchGet ทุกแท็บ) =====
# v2 = ไฟล์เดิม · v3 = ไฟล์ SakbinBotLibrary-v3 (อ่านเมื่อ SHEET_SCHEMA=v3 เท่านั้น)
SHEET_BOTLIB_ID=
SHEET_BOTLIB_V3_ID=

# ===== สวิตช์ schema (D-61 · env-only ถาวร) =====
# ว่าง/ค่าอื่น = v2 (พฤติกรรมเดิม 100%) · v3 = สมองใหม่ "บอทนักขาย CX"
SHEET_SCHEMA=

# ===== ส่งต่อแอดมิน / Handoff =====
ADMIN_GROUP_ID=

# ===== ระบบออเดอร์ + สลิป =====
ORDER_GROUP_ID=
SHEET_ORDERS_ID=
GOOGLE_SERVICE_ACCOUNT=
BLOB_SLIPS_TOKEN=
BLOB_PRODUCTS_TOKEN=

# ===== cron auth =====
CRON_SECRET=

# ===== ห้องซ้อมเทรน /train (T-STUDIO) =====
# ไม่มี TRAIN_PASSWORD = ปิดทั้งฟีเจอร์ (404 ทั้งก้อน)
TRAIN_PASSWORD=
DATABASE_URL_TRAIN=
# optional — แยกโควตา Gemini ของผู้ช่วยเทรนออกจากบอทหลัก · ว่าง = ใช้ GEMINI_API_KEY
GEMINI_API_KEY_TRAIN=

# ===== Meta Messenger adapter (M-2) =====
# 🔴 อ่านได้เฉพาะใน lib/channel/pages.ts เท่านั้น
META_APP_SECRET=
META_VERIFY_TOKEN=
META_APP_ID=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# ===== diag (ปกติปิด) =====
# =1 → gemini.ts log token จริงต่อ segment ด้วย countTokens
DIAG_PROMPT_TOKENS=
